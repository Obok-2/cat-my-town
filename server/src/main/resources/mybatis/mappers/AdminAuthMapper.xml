<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.catmytown.server.admin.auth.AdminAuthDao">

    <select id="selectAdminByEmail" resultType="AdminUserVo">
        SELECT id,
               email,
               password_hash,
               name,
               role
          FROM admin_users
         WHERE LOWER(email) = #{email}
    </select>

</mapper>
