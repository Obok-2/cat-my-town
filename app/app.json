{
  "expo": {
    "name": "우리동네고양이",
    "slug": "cat-my-town",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.obok2.catmytown",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "산책하다 마주친 길고양이를 촬영해서 도감에 기록하려면 카메라 접근이 필요해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "우리동네고양이가 목격 위치를 기록하도록 허용해주세요."
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.8280267462-ockas7pdj7eb2644kbsvsgt4fsfmivk7"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E6D4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 184,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1E1B18"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cd3d4d58-58c4-47df-b294-8da5cc153c88"
      }
    }
  }
}
